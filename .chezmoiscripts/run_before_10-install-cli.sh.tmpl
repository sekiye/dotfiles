#!/usr/bin/env bash
set -euo pipefail

find_brew() {
  if command -v brew >/dev/null 2>&1; then
    command -v brew
    return 0
  fi

  local candidate
  for candidate in \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

if ! BREW="$(find_brew)"; then
  echo "Homebrew not found." >&2
  exit 1
fi

eval "$("$BREW" shellenv bash)"
BREWFILE='{{ .chezmoi.sourceDir }}/packages/Brewfile'

echo "==> Ensuring Homebrew packages"
if ! brew bundle check --file="$BREWFILE" >/dev/null 2>&1; then
  brew bundle install --file="$BREWFILE"
fi

# Intentionally no `brew bundle cleanup`: Homebrew can contain unrelated tools.
